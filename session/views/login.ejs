<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Login</title>

    <style>
        *{
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: Arial, sans-serif;
        }

        body{
            min-height: 100vh;
            background: linear-gradient(135deg, #6a11cb, #2575fc);
            display: flex;
            justify-content: center;
            align-items: center;
            padding: 30px 0; /* top and bottom margin */
        }

        .login-box{
            width: 320px;
            background: white;
            padding: 18px;
            border-radius: 12px;
            box-shadow: 0 8px 20px rgba(0,0,0,.15);
        }

        .login-box h2{
            text-align: center;
            color: #333;
            margin-bottom: 15px;
            font-size: 24px;
        }

        .form-group{
            margin-bottom: 10px;
        }

        label{
            display: block;
            margin-bottom: 4px;
            color: #555;
            font-size: 14px;
            font-weight: 600;
        }

        input{
            width: 100%;
            height: 38px;
            padding: 0 10px;
            border: 1px solid #ccc;
            border-radius: 8px;
            outline: none;
            font-size: 14px;
        }

        input:focus{
            border-color: #2575fc;
        }

        button{
            width: 100%;
            height: 38px;
            background: #2575fc;
            color: white;
            border: none;
            border-radius: 8px;
            font-size: 15px;
            cursor: pointer;
        }

        button:hover{
            background: #1b5fd6;
        }

        .links{
            text-align: center;
            margin-top: 12px;
            font-size: 13px;
        }

        .links a{
            text-decoration: none;
            color: #2575fc;
            font-weight: 600;
        }
    </style>
</head>
<body>

    <div class="login-box">

        <h2>Login</h2>

        <form action="/login" method="post">

            <div class="form-group">
                <label>Name</label>
                <input
                    type="text"
                    name="name"
                    id="name"
                    placeholder="Enter your username"
                    required>
            </div>

            <div class="form-group">
                <label>Password</label>
                <input
                    type="password"
                    name="password"
                    id="password"
                    placeholder="Enter your password"
                    required>
            </div>

            <button type="submit">Login</button>

            <div class="links">
                <a href="/login">Reset</a>
                <br><br>
                Don't have an account?
                <a href="/">Register</a>
            </div>

        </form>

    </div>

</body>
</html>