<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit Rooms</title>

    <style>
        *{
            margin:0;
            padding:0;
            box-sizing:border-box;
            font-family: Arial, sans-serif;
        }

        body{
            min-height:100vh;
            display:flex;
            justify-content:center;
            align-items:center;
            background:linear-gradient(135deg,#74ebd5,#9face6);
        }

        .container{
            width:350px;
            background:white;
            padding:25px;
            border-radius:15px;
            box-shadow:0 10px 25px rgba(0,0,0,0.15);
        }

        h2{
            text-align:center;
            color:#333;
            margin-bottom:20px;
        }

        .form-group{
            margin-bottom:15px;
        }

        label{
            display:block;
            margin-bottom:5px;
            color:#555;
            font-size:14px;
            font-weight:600;
        }

        input{
            width:100%;
            height:40px;
            padding:0 10px;
            border:1px solid #ccc;
            border-radius:8px;
            outline:none;
            font-size:14px;
        }

        input:focus{
            border-color:#2575fc;
        }

        button{
            width:100%;
            height:40px;
            border:none;
            border-radius:8px;
            background:#2575fc;
            color:white;
            font-size:15px;
            cursor:pointer;
            margin-top:10px;
        }

        button:hover{
            background:#1b5fd6;
        }
    </style>
</head>
<body>

    <div class="container">

        <h2>Edit Room</h2>

        <form action="/updateRooms/<%= roomData._id %>?_method=patch" method="post">

            <div class="form-group">
                <label>Room Number</label>
                <input
                    type="text"
                    name="RoomNo"
                    value="<%= roomData.RoomNo %>"
                    required
                >
            </div>

            <div class="form-group">
                <label>Room Type</label>
                <input
                    type="text"
                    name="RoomType"
                    value="<%= roomData.RoomType %>"
                    required
                >
            </div>

            <div class="form-group">
                <label>Price</label>
                <input
                    type="text"
                    name="Price"
                    value="<%= roomData.Price %>"
                    required
                >
            </div>

            <div class="form-group">
                <label>Capacity</label>
                <input
                    type="text"
                    name="capacity"
                    value="<%= roomData.capacity %>"
                    required
                >
            </div>

            <button type="submit">
                Update Room
            </button>

        </form>

    </div>

</body>
</html>